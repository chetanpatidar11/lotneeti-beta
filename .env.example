# Local-only settings. Copy to .env and change values for your machine.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=lotneeti
POSTGRES_USER=lotneeti
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379/0
API_BASE_URL=http://127.0.0.1:8000/api/v1
FRONTEND_BASE_URL=http://127.0.0.1:3000
DEFAULT_FROM_EMAIL=LotNeeti <no-reply@localhost>
# Choose ALLOW, WARN, or DISALLOW before planner previews.
PLANNER_PLATFORM_CROSS_FUNDING_POLICY=
# Private S3 bucket for generated plan exports (no public access).
EXPORT_S3_BUCKET=
